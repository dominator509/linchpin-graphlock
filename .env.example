# LINCHPIN does not store first-party provider OAuth tokens here.
LINCHPIN_LOG_LEVEL=info
LINCHPIN_DATA_DIR=C:\Users\example\AppData\Local\Linchpin
LINCHPIN_EGRESS_DEFAULT=LOCAL_ONLY
LINCHPIN_LOCAL_PROVIDER_URL=http://127.0.0.1:11434
LINCHPIN_LOCAL_MODEL_ID=example-local-model
# Optional official patent/science data service credentials only when the selected service requires them:
USPTO_ODP_API_KEY=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
# Optional API fallback keys are disabled unless the user opts in:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
