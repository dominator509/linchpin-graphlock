{
  "$schema": "https://schema.tauri.app/v2/config.json",
  "productName": "LINCHPIN",
  "version": "0.1.0",
  "identifier": "com.linchpin.app.e2e",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LINCHPIN Patent Intelligence OS",
        "additionalBrowserArgs": "--remote-debugging-port=9222",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
